# AZTCSE Environment Configuration
# Edit these values for your deployment

APP_NAME=AZTCSE
VERSION=2.0.0
DEBUG=false
SECRET_KEY=change-this-in-production-iiit-nagpur-2024

# Server
HOST=0.0.0.0
PORT=8000

# Neo4j (if running Docker container above)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aztcse_secure_pass

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS Credentials (REQUIRED for real cloud scanning)
# Get from: aws configure
 AWS_ACCESS_KEY_ID=
 AWS_SECRET_ACCESS_KEY=
 AWS_REGION=ap-south-1
 AWS_ACCOUNT_ID=710215922764

# Engine Settings
AUTO_RESPONSE_ENABLED=true
HUMAN_APPROVAL_THRESHOLD=0.95
JIT_ACCESS_DURATION_MINUTES=60
SESSION_REVALIDATION_INTERVAL=300

# Notifications (optional)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/your-webhook
